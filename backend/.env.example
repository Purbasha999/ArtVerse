# MongoDB connection string (create a fresh database for ArtVerse)
DB_URL=mongodb+srv://<user>:<password>@<cluster>/artverse

# Cloudinary (generate a new API key/secret under your Cloudinary account)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# MapTiler (generate a new API key)
MAPTILER_API_KEY=

# Session secret - use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# URL of the React frontend (for CORS + cookie config)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development

PORT=3000
